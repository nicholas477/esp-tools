<Window x:Class="esp_tools_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:esp_tools_gui"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <!-- Register your visibility converter so XAML can see it -->
        <local:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel  Margin="10,10,10,10">
        <!-- Loading popup -->
        <Popup x:Name="LoadingPopup" 
               Placement="Center" 
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               AllowsTransparency="True" 
               IsOpen="False">
            <Border Background="#F3F3F3" BorderBrush="#CCCCCC" BorderThickness="1" Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.2" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel Width="250">
                    <TextBlock Text="Loading data, please wait..." Margin="0,0,0,12" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="MyProgressBar" Height="15" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Popup>
        
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Content="Button 1" Width="100" Margin="5"/>
            <Button Content="Button 2" Width="100" Margin="5"/>
            <Button Content="Button 3" Width="100" Margin="5"/>
        </StackPanel>
        <TabControl DockPanel.Dock="Top">
            <TabItem Header="Reference Tree">
                <TreeView ItemsSource="{Binding TreeRootNodes}">
                    <!-- 1. Define the Visual Template for your Custom Class -->
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <!-- Checkbox -->
                                <CheckBox IsChecked="{Binding ShouldExport, Mode=TwoWay}" VerticalAlignment="Center"/>

                                <!-- Main Title Text -->
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="14"/>

                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                    <!-- 2. Connect UI States (like Selection) back to your Custom Class -->
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <!-- TwoWay binding connects UI selection state to your C# IsSelected property -->
                            <!--<Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />-->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            
                            <!-- Initialize to expanded by default -->
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>

                </TreeView>
            </TabItem>
            <TabItem Header="File View" >
                <ListView/>

            </TabItem>
        </TabControl>
    </DockPanel>
</Window>